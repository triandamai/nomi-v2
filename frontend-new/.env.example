# Nomi frontend-new (SvelteKit, adapter-node) configuration. Copy to `.env` for `npm run dev`, or set
# these in the host's environment for `node server.js` (after `npm run build`).

# Where the backend API is, as this server reaches it. The browser never talks to it directly: API
# calls, live updates and uploads all go through this server. Default: http://localhost:8080
API_URL=http://localhost:8080

# The design-system gallery at /design-system: on by default in `npm run dev`; set to 1 to keep it
# in a preview or review build. Off in production.
PUBLIC_DS_GALLERY=1

# --- Production server (`node server.js`) only ---

# Address and port the server listens on. Defaults: 0.0.0.0 and 3000.
# HOST=0.0.0.0
# PORT=3000

# The public address people open. Required behind a reverse proxy or HTTPS terminator, or every
# form is refused as a cross-site request.
# ORIGIN=https://your-site.example

# Largest request body accepted. Default: 512K. (Attachments and avatars bypass it: they stream
# straight to the backend.)
# BODY_SIZE_LIMIT=10M

# The version the app shows and sends to the backend (X-Client-Version). Release builds set it from
# the git tag; set it only to label a build yourself. Default: `git describe`.
# APP_VERSION=1.2.3
