{
  "name": "nomi-baas-cli",
  "version": "0.1.0",
  "description": "Command line for Nomi BaaS: migrations, linting and functions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triandamai/nomi-v2.git",
    "directory": "baas/cli"
  },
  "keywords": ["nomi", "baas", "migrations", "cli"],
  "bin": {
    "nomi-baas": "dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
