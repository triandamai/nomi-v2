# Nomi backend configuration. Copy to `.env` (or set these in your host's environment) and fill in
# the REQUIRED values. Everything else is optional: leave it commented out to use the default
# shown. The backend binary (`nomi-orchestrator`) and the standalone worker (`worker`) read the
# same variables, so give both processes the same environment.

# =================================================================================================
# Required
# =================================================================================================

# REQUIRED. Postgres 16 with the pgvector extension. Migrations run automatically at startup.
# Matches the database `docker compose up` (backend/docker-compose.yml) starts locally.
DATABASE_URL=postgres://nomi:nomi@localhost:5432/nomi

# REQUIRED. Signs and verifies login tokens. Any long random string; changing it logs everyone out.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# REQUIRED. AES-256-GCM key that encrypts every secret stored in the database: model API keys,
# the embedding key, users' Google tokens, and tool keys from Admin -> Tools (e.g. the Tavily key).
# Exactly 64 hex characters (32 bytes). Keep it safe and never change it on a running install:
# a different key can't read secrets saved with the old one (they'd have to be entered again).
# Generate one with: openssl rand -hex 32   (looks like 3f9c...e41a, 64 characters)
# Left blank on purpose: the server won't start until you set a real one.
SETTINGS_ENCRYPTION_KEY=

# =================================================================================================
# Server and workers
# =================================================================================================

# MQTT broker that carries live chat updates (streaming replies, agent status) from the workers to
# the server. Any MQTT 3.1.1/5 broker works (EMQX in docker-compose.yml, Mosquitto, ...).
# Defaults: localhost, 1883.
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883

# The turn-processing worker runs inside the server process by default, so one process is enough.
# Set to `false` to run workers separately (`cargo run --bin worker`, or the `worker` binary), e.g.
# to scale them apart from the HTTP server. The server listens on 0.0.0.0:8080.
# RUN_WORKER_INLINE=false

# How many chats one worker answers at the same time (each chat's turns still run one at a time).
# Default: 4.
# TURN_CONCURRENCY=4

# Longest one agent turn may run, in seconds, before it's stopped and the person is told.
# Default: 600 (10 minutes).
# TURN_TIME_LIMIT_SECS=600

# Log detail (standard tracing filter syntax).
# Default: nomi_orchestrator=debug,nomi_server=debug,tower_http=debug,info
# RUST_LOG=info

# =================================================================================================
# Email (sign-in codes)
# =================================================================================================

# Every email-and-password sign-in, and every new account, is finished with a 6-digit code sent
# to the account's email (Google sign-in doesn't need one). Set to `off` to sign people in with
# just their password. Default: on.
# AUTH_EMAIL_CODES=off

# The SMTP server that sends those emails. Any provider works, e.g.:
#   Brevo      smtp-relay.brevo.com:587   (300 emails/day free)
#   Resend     smtp.resend.com:465        (3,000/month free; username "resend", password = API key)
#   Amazon SES email-smtp.<region>.amazonaws.com:587
#   Gmail      smtp.gmail.com:587         (with an app password; low daily limit)
# Without SMTP_HOST, emails (and so the codes) are only written to the server log: fine for
# development, but nobody can sign in with a password unless they can read that log.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=your-smtp-key
# starttls (port 587, the default), tls (port 465) or none (local test servers only).
# SMTP_SECURITY=starttls
# Who the emails come from. Must be an address or domain your provider lets you send from.
# MAIL_FROM=Nomi <no-reply@your-site.example>

# =================================================================================================
# Models (optional: normally set in Admin -> Models / Admin -> Embeddings)
# =================================================================================================

# Chat model fallback. Only used while no model has been added in Admin -> Models; once one
# exists these are ignored. Handy for a fresh install. Providers: anthropic, openai, gemini,
# deepseek, openrouter, fake (canned replies, for development).
# LLM_PROVIDER=anthropic
# LLM_MODEL_ID=claude-haiku-4-5
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=

# Embedding fallback (turns memories into vectors). Only used at startup while no embedding
# provider has been saved in Admin -> Embeddings. Providers: openai, gemini, cohere, fake.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL_ID=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=

# =================================================================================================
# Web search tools (optional: normally set in Admin -> Tools)
# =================================================================================================

# Lets agents search the internet (`web_search`). The provider is chosen in Admin -> Tools
# (Tavily by default); a key saved there wins over these. With no key for the chosen provider,
# agents simply aren't offered web search.
#
# Tavily (default, recommended): 1,000 free searches a month, no card. https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
# Serper (Google results, cheapest per search): https://serper.dev
# SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Brave Search API: https://api-dashboard.search.brave.com
# BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Self-hosted SearXNG (free; enable the `json` format in its settings.yml):
# SEARXNG_URL=http://searxng:8080

# `read_web_page` refuses private and local addresses (localhost, 10.x, 192.168.x, ...) so agents
# can't be used to reach your internal network. Set to 1 only for local development.
# NOMI_WEB_ALLOW_PRIVATE=1

# =================================================================================================
# Google (optional): "Continue with Google" sign-in and the Workspace agent
# =================================================================================================

# One "Web application" OAuth client in Google Cloud serves both. Enable the Gmail, Sheets, Docs,
# Drive and Calendar APIs, and add BOTH callback pages (on your site's address) as authorized
# redirect URIs:
#   https://your-site.example/connections/google/callback   (Workspace)
#   https://your-site.example/auth/google/callback          (sign-in)
# Leave these unset to hide the Google buttons.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=http://localhost:5173/connections/google/callback
# Defaults to /auth/google/callback on the same site as GOOGLE_REDIRECT_URI.
# GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Development only: send every Google call to a fake server instead.
# GOOGLE_FAKE_BASE_URL=http://localhost:9090

# =================================================================================================
# Storage (optional)
# =================================================================================================

# Where the Coding agent keeps project files, on local disk. Use a persistent volume in production.
# Default: ./data/projects
# PROJECT_FILES_DIR=/var/lib/nomi/projects

# Where files people attach in chat are kept when S3_BUCKET is unset. Use a persistent volume in
# production, shared by the server and any separate worker. Default: ./data/attachments
# ATTACHMENTS_DIR=/var/lib/nomi/attachments

# How much people may attach. Defaults: 10 MB a file, 50 MB a video, 10 files and 100 MB a
# message, 2048 MB stored per person.
# ATTACHMENT_MAX_FILE_MB=10
# ATTACHMENT_MAX_VIDEO_MB=50
# ATTACHMENT_MAX_MESSAGE_MB=100
# ATTACHMENT_MAX_FILES=10
# ATTACHMENT_QUOTA_MB=2048

# S3-compatible bucket for profile pictures and chat attachments (attachments stay private: only
# the server reads them back). Leave S3_BUCKET unset to turn avatar uploads off and keep
# attachments on disk. When S3_BUCKET is set, the AWS_* keys are required. Works with AWS S3,
# Cloudflare R2, MinIO...
# S3_BUCKET=nomi-avatars
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only for non-AWS providers (R2, MinIO, ...):
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Public address files are served from. Default: https://<bucket>.s3.<region>.amazonaws.com
# S3_PUBLIC_URL_BASE=https://cdn.your-site.example

# =================================================================================================
# Tuning (optional)
# =================================================================================================

# Tokens each person may use per month on the free plan. Default: 1000000.
# FREE_MONTHLY_TOKENS=1000000

# How close (0 to 1, cosine similarity) a memory must be to the message to be recalled. Lower
# recalls more, higher only the closest. Default: 0.3.
# MEMORY_MIN_SIMILARITY=0.3
