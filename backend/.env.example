# Postgres connection string used by the backend and its migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nomi

# Secret used to sign/verify JWTs issued for authenticated sessions.
JWT_SECRET=change-me-to-a-long-random-string

# Required. AES-256-GCM key used to encrypt/decrypt provider API keys stored
# in the provider_settings table. Must be exactly 64 hex characters (32 bytes).
# Generate one with:
#   openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# --- LLM provider fallback (optional) ---
# Only used at boot when no LLM row exists yet in provider_settings (i.e.
# before an admin has configured a provider via the admin settings UI/API).
# Once a provider is saved through the app, these env vars are ignored.
# LLM_PROVIDER=anthropic
# LLM_MODEL_ID=claude-haiku-4-5
# LLM_API_KEY=
# LLM_BASE_URL=

# --- Embedding provider fallback (optional) ---
# Only used at boot when no embedding row exists yet in provider_settings.
# Once a provider is saved through the app, these env vars are ignored.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL_ID=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
