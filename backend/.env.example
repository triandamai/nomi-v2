# Postgres connection string used by the backend and its migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nomi

# Secret used to sign/verify JWTs issued for authenticated sessions.
JWT_SECRET=change-me-to-a-long-random-string

# Required. AES-256-GCM key used to encrypt/decrypt API keys stored in the
# admin_llm_models, user_llm_selections, and provider_settings (embedding) tables.
# Must be exactly 64 hex characters (32 bytes). Generate one with:
#   openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Optional. The turn-processing worker (backend/src/worker.rs) runs embedded inside this
# server process by default, so a single `cargo run` is enough to actually process messages —
# no separate `cargo run --bin worker` needed. Set to `false` to disable the embedded worker
# and run it as its own process(es) instead (e.g. for horizontal worker scaling independent of
# HTTP server instances).
# RUN_WORKER_INLINE=false

# --- LLM provider fallback (optional) ---
# Only used when no admin_llm_models rows exist at all yet (i.e. before an admin has
# added a model via the admin settings UI/API). Resolved per turn by the worker, not
# just at boot — once an admin adds at least one model, these env vars stop being
# consulted for any user, even ones with no personal selection (they fall back to
# the admin default instead). Useful for a fresh install with nothing configured yet.
# LLM_PROVIDER=anthropic
# LLM_MODEL_ID=claude-haiku-4-5
# LLM_API_KEY=
# LLM_BASE_URL=

# --- Embedding provider fallback (optional) ---
# Only used at boot when no embedding row exists yet in provider_settings.
# Once a provider is saved through the app, these env vars are ignored.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL_ID=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
