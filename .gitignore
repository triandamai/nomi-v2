!.claude/agents/
!.claude/hooks/
!.claude/skills/
.junie/
.superpowers/
.worktrees/
.idea/

/backend/target

# Local file storage (attachments, project files)
/backend/data/
/backend/crates/*/data/

# Native apps (Kotlin Multiplatform)
native/.gradle/
native/.kotlin/
native/**/build/
native/local.properties
native/iosApp/**/xcuserdata/

# Backend coverage (cargo llvm-cov report)
backend/coverage/
backend/coverage.json

# Nomi harness
.claude/state/

.DS_Store
