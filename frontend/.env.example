# Nomi frontend (SvelteKit, adapter-node) configuration. Copy to `.env` for `npm run dev`, or set
# these in your host's environment for `node server.js` (after `npm run build`).

# Where the backend API is, as the frontend server reaches it (it's never exposed to the browser:
# the frontend proxies API calls and live chat updates). Default: http://localhost:8080
API_URL=http://localhost:8080

# --- Production server (`node server.js`) only ---

# Address and port the server listens on. Defaults: 0.0.0.0 and 3000.
# HOST=0.0.0.0
# PORT=3000

# The public address people open. Required behind a reverse proxy or HTTPS terminator, or every
# form (login, settings, ...) is refused as a cross-site request.
# ORIGIN=https://your-site.example

# Behind a proxy that sets these headers, instead of ORIGIN:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Largest request body accepted (e.g. attachments sent with a message). Default: 512K.
# BODY_SIZE_LIMIT=10M

# The version the app shows and sends to the backend (X-Client-Version). Release builds take it
# from the git tag automatically (release.yml passes it to the Docker build); set it only to
# label a build yourself. Default: `git describe` (e.g. 0.0.15-68-g419e492).
# APP_VERSION=1.2.3
